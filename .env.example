# ============================================================
# MES 容器化环境变量配置
# 复制本文件为 .env 并填入真实值，切勿提交到版本库
# 必填项（无默认值，缺失时 docker compose 直接报错）：
#   POSTGRES_PASSWORD / JWT_SECRET / MES_INIT_PASSWORD
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=mes
POSTGRES_USER=mes
# 必填：数据库密码，建议 16 位以上随机
POSTGRES_PASSWORD=

# ---------- Spring Boot（prod profile） ----------
# 必填：JWT 签名密钥，至少 32 字符，建议：openssl rand -base64 48
JWT_SECRET=
# 必填：admin 初始密码，首次启动后建议立即在系统里修改
MES_INIT_PASSWORD=
# CORS 允许的源，多个用逗号分隔；生产请填实际域名而非 *
MES_CORS_ORIGINS=*
# 首次登录是否强制改密（默认 true）
MES_FORCE_PASSWORD_CHANGE=true

# ---------- 可选：数据库连接池 ----------
# DB_POOL_SIZE=20
# DB_POOL_MIN_IDLE=5
