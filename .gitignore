# build outputs
mes-backend/target/
mes-frontend/dist/
mes-frontend/node_modules/
mes-uniapp/dist/
mes-uniapp/node_modules/

# 前端打包产物同步到这里给后端打包用，属于构建产物，不进版本库
# 重新生成：powershell -ExecutionPolicy Bypass -File scripts\build.ps1
mes-backend/src/main/resources/static/

# 附件本地存储目录（默认 storage.local.root = data/attachments）
mes-backend/data/
data/

# 运行日志（logback 默认写工作目录下 logs/）
logs/
mes-backend/logs/
*.log
*.log.gz

# JVM 崩溃与回放日志（可能含运行时内存信息，不要提交）
hs_err_pid*.log
replay_pid*.log
*.hprof

# 本地数据库备份、附件打包（含业务数据，不要提交）
backups/
*.dump

# 页面截图与临时截图（README / docs 未引用，不再跟踪）
screenshots/
.screenshots/

# ide
.idea/
.vscode/
*.iml

# os
Thumbs.db
.DS_Store

# 环境变量与密钥（.env.example 可提交，.env 不可）
.env
.env.local
.env.*.local
